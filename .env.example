# Icebreaker 345 Pro - Python Backend Configuration
# ================================================
# NEVER commit .env to git. Set secrets via hosting dashboard.

# Server
PORT=5000
FLASK_DEBUG=0

# Database (SQLite - persistent)
DATABASE_PATH=./icebreaker.db

# APNs Push Notifications
# -----------------------
# 1. Create APNs key in Apple Developer Console
# 2. Download .p8 file
# 3. Set values below (NEVER commit .p8 file)
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_KEY_PATH=./AuthKey.p8
APNS_BUNDLE_ID=com.yourcompany.icebreaker345pro
APNS_PRODUCTION=false

# Scraping
SCRAPE_INTERVAL_MINUTES=15

# Admin API Key (for manual scrape, test notifications)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=your_secure_random_key_here
